[Unit]
Description=NAS GPU Platform Streamlit App
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Neural-Architecture-Search-NAS-on-GPUs
Environment=PYTHONUNBUFFERED=1
Environment=STREAMLIT_SERVER_HEADLESS=true
ExecStart=/home/ubuntu/Neural-Architecture-Search-NAS-on-GPUs/.venv/bin/streamlit run streamlit_app/app.py --server.address=0.0.0.0 --server.port=8501
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
